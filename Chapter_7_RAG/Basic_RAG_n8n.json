{
  "name": "Ai3x_Basic_RAG",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Upload Document for RAG",
        "formDescription": "Upload one or more PDF, CSV, or JSON files to add to knowledge base",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload files",
              "fieldType": "file",
              "fieldName": "files",
              "acceptFileTypes": ".pdf, .csv, .json. .docs. .txt, .html"
            }
          ]
        },
        "options": {}
      },
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "webhookId": "39e7ae74-f22d-41f0-952b-b8df948fdd97"
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Embeddings OpenAI Small",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "dataType": "binary",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "fileName",
                "value": "={{ $('On form submission').item.json.files[0].mimetype }}"
              },
              {
                "name": "uploadedAt",
                "value": "={{ $('On form submission').item.json.submittedAt }}"
              }
            ]
          }
        }
      },
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "chunkOverlap": 200,
        "options": {}
      },
      "name": "Recursive Character Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "__rl": true,
          "value": "ai3x-1536",
          "mode": "list",
          "cachedResultName": "ai3x-1536"
        },
        "options": {}
      },
      "name": "Store the Documents to Vector DB",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "public": true,
        "options": {}
      },
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "webhookId": "a7106253-87bc-42b8-9f61-d687299247f8"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful assistant that answers questions based ONLY on the retrieved documents. Use the Retrieve from Pinecone tool to search for relevant information. If you cannot find the answer in the retrieved documents, respond with: I couldn't find that in the uploaded documents. Always cite which document (fileName) you found the information in."
        }
      },
      "name": "RAG Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "name": "Brain - gpt-5 - Mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3
    },
    {
      "parameters": {},
      "name": "Model Chat memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the uploaded documents knowledge base to find relevant information",
        "pineconeIndex": {
          "__rl": true,
          "value": "ai3x-1536",
          "mode": "list",
          "cachedResultName": "ai3x-1536"
        },
        "options": {}
      },
      "name": "Pinecone Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2
    }
  ],
  "connections": {
    "On form submission": {
      "main": [
        [
          {
            "node": "Store the Documents to Vector DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings OpenAI Small": {
      "ai_embedding": [
        [
          {
            "node": "Store the Documents to Vector DB",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Default Data Loader": {
      "ai_document": [
        [
          {
            "node": "Store the Documents to Vector DB",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "Recursive Character Text Splitter": {
      "ai_textSplitter": [
        [
          {
            "node": "Default Data Loader",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "When chat message received": {
      "main": [
        [
          {
            "node": "RAG Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Brain - gpt-5 - Mini": {
      "ai_languageModel": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Model Chat memory": {
      "ai_memory": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Pinecone Vector Store": {
      "ai_tool": [
        [
          {
            "node": "RAG Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings OpenAI": {
      "ai_embedding": [
        [
          {
            "node": "Pinecone Vector Store",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}